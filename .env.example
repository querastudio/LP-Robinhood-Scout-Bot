# --- Wajib ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=            # id Telegram numerik pemilik; bot hanya menjawab id ini

# --- RPC Robinhood Chain (chainId 4663). Tanpa ini, fee/keamanan on-chain = "belum terverifikasi" ---
RPC_URL=                      # atau isi ALCHEMY_API_KEY (slug robinhood-mainnet)
ALCHEMY_API_KEY=
V4_POOL_MANAGER=              # alamat PoolManager Uniswap V4 di Robinhood (untuk fee/hook pool V4; BELUM terverifikasi)

# --- Jadwal & alert ---
SCAN_MINUTES=15
ALERT_COOLDOWN_HOURS=2
ALERT_MIN_LABEL=minimal       # minimal | bagus | ideal
SCAN_PAGES=8                  # 20 pool/halaman, urut volume 24j (GeckoTerminal)
TOP_CANDIDATES=20

# --- Penyaringan ---
MIN_TVL=10000
LOW_TVL=25000                 # di bawah ini label turun satu tingkat
MAX_DROP_24H=0.50             # harga 24j turun lebih dari ini -> turun satu tingkat
PROTOCOL_FEE_SHARE=0          # bagian protokol dari fee, bila diketahui
MAJOR_SYMBOLS=                # kosong = bawaan (eth,weth,usdg,usdc,usdt,dai,wbtc,hbtc,cbbtc,btc,...)
EXCLUDED_DEXES=               # kosong = bawaan (dex V2/launchpad)

# --- Ambang label (SEMENTARA, dari backtest Meteora Solana; belum divalidasi di Robinhood) ---
# LABEL_{IDEAL|BAGUS|MINIMAL}_{FEE_YIELD|NET_EDGE|ACTIVITY|CONCENTRATION|PACE6H}
LABEL_IDEAL_FEE_YIELD=0.20
LABEL_IDEAL_NET_EDGE=0.10
LABEL_BAGUS_FEE_YIELD=0.10
LABEL_BAGUS_NET_EDGE=0.05
LABEL_MINIMAL_FEE_YIELD=0.05
LABEL_MINIMAL_NET_EDGE=0.02

# --- Penyimpanan ---
STATE_PATH=data/state.json
CACHE_PATH=data/cache.json
